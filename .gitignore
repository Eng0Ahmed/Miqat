# ==========================================
# Miqat (ميقات) - .gitignore
# ==========================================

# Dependencies
node_modules/
package-lock.json

# Rust & Tauri Build Outputs
target/
src-tauri/target/
*.pdb

# Local Execution Binaries (distributables to be placed in GitHub Releases)
*.exe
*.msi
*.zip
*.tar.gz

# Logs & Runtime Diagnostics
*.log
widget_runtime.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor generated files
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.user

# Temporary files
temp_check.js
scratch/
*.tmp
