{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables default permissions for all windows",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "notification:default",
    "autostart:default",
    "global-shortcut:default"
  ]
}
